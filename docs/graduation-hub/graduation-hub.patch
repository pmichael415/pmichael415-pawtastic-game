+import { describe, expect, it } from "vitest";
+import { HUB_ORIGINS, hubOrigin, preflight, returnBase, withCors } from "./hub";
+
+const SITE = "https://pawtastic-graduation.lovable.app";
+const HUB = "https://paw-sitive-playhouse-rush.lovable.app";
+const req = (path: string, init: RequestInit & { origin?: string } = {}) => {
+  const headers = new Headers(init.headers);
+  if (init.origin) headers.set("Origin", init.origin);
+  return new Request(`${SITE}${path}`, { ...init, headers });
+};
+
+describe("the PAWtastic Games hub", () => {
+  it("lists exactly the hub addresses the owner publishes", () => {
+    expect(HUB_ORIGINS).toEqual([
+      "https://paw-sitive-playhouse-rush.lovable.app",
+      "https://id-preview--acd6158e-ca42-414d-a979-e8b24d27b4b1.lovable.app",
+      "https://play.pawtasticacademy.com",
+    ]);
+  });
+  it("recognises only an allowlisted Origin, never this site itself", () => {
+    expect(hubOrigin(req("/api/public/game/config", { origin: HUB }))).toBe(HUB);
+    expect(
+      hubOrigin(req("/api/public/game/config", { origin: "https://attacker.invalid" })),
+    ).toBeNull();
+    expect(
+      hubOrigin(req("/api/public/game/config", { origin: `${HUB}.attacker.invalid` })),
+    ).toBeNull();
+    expect(hubOrigin(req("/api/public/game/config"))).toBeNull();
+    expect(
+      hubOrigin(
+        new Request("https://play.pawtasticacademy.com/x", {
+          headers: { Origin: "https://play.pawtasticacademy.com" },
+        }),
+      ),
+    ).toBeNull();
+  });
+  it("answers the browser permission check for the game API, from the hub only", () => {
+    const ok = preflight(req("/api/public/game/checkout", { method: "OPTIONS", origin: HUB }))!;
+    expect(ok.status).toBe(204);
+    expect(ok.headers.get("Access-Control-Allow-Origin")).toBe(HUB);
+    expect(ok.headers.get("Access-Control-Allow-Headers")).toMatch(/authorization/);
+    expect(ok.headers.get("Access-Control-Allow-Headers")).toMatch(/content-type/);
+    expect(ok.headers.get("Access-Control-Allow-Methods")).toMatch(/PUT/);
+    expect(ok.headers.get("Access-Control-Allow-Credentials")).toBeNull();
+    expect(ok.headers.get("Vary")).toBe("Origin");
+    // Everything else goes on to the app as before.
+    expect(
+      preflight(
+        req("/api/public/game/checkout", { method: "OPTIONS", origin: "https://attacker.invalid" }),
+      ),
+    ).toBeNull();
+    expect(preflight(req("/api/public/game/checkout", { method: "POST", origin: HUB }))).toBeNull();
+    expect(
+      preflight(req("/api/public/stripe/webhook", { method: "OPTIONS", origin: HUB })),
+    ).toBeNull();
+    expect(preflight(req("/api/public/game/staff", { method: "OPTIONS", origin: HUB }))).toBeNull();
+    expect(
+      preflight(req("/api/public/game/staff/prizes", { method: "OPTIONS", origin: HUB })),
+    ).toBeNull();
+    expect(preflight(req("/staff", { method: "OPTIONS", origin: HUB }))).toBeNull();
+  });
+  it("lets the hub read game API answers, unchanged otherwise", async () => {
+    const answer = () =>
+      Response.json({ payments: true }, { status: 201, headers: { "Cache-Control": "no-store" } });
+    const opened = withCors(req("/api/public/game/config", { origin: HUB }), answer());
+    expect(opened.status).toBe(201);
+    expect(opened.headers.get("Access-Control-Allow-Origin")).toBe(HUB);
+    expect(opened.headers.get("Cache-Control")).toBe("no-store");
+    expect(await opened.json()).toEqual({ payments: true });
+    for (const r of [
+      req("/api/public/game/config", { origin: "https://attacker.invalid" }),
+      req("/api/public/game/config"),
+      req("/api/public/game/staff", { origin: HUB }),
+      req("/api/public/stripe/webhook", { origin: HUB }),
+      req("/play/index.html", { origin: HUB }),
+    ]) {
+      const same = answer();
+      expect(withCors(r, same)).toBe(same);
+    }
+  });
+  it("sends a buyer back where they bought: the hub, or this site", () => {
+    expect(
+      returnBase(req("/api/public/game/checkout", { method: "POST", origin: HUB }), SITE),
+    ).toBe(`${HUB}/graduation`);
+    expect(
+      returnBase(req("/api/public/game/checkout", { method: "POST", origin: SITE }), SITE),
+    ).toBe(`${SITE}/play/index.html`);
+    expect(
+      returnBase(
+        req("/api/public/game/checkout", { method: "POST", origin: "https://attacker.invalid" }),
+        SITE,
+      ),
+    ).toBe(`${SITE}/play/index.html`);
+    expect(returnBase(req("/api/public/game/checkout", { method: "POST" }), SITE)).toBe(
+      `${SITE}/play/index.html`,
+    );
+  });
+});
diff --git a/src/lib/game/hub.ts b/src/lib/game/hub.ts
new file mode 100644
index 0000000..0b13019
--- /dev/null
+++ b/src/lib/game/hub.ts
@@ -0,0 +1,65 @@
+// The PAWtastic Games hub plays a copy of Graduation Day from its own address and uses this server for
+// sign-in, cloud saves, the Weekly Challenge, the leaderboard and the Shop. Browsers only let a page read
+// another site's answers when that site says so (CORS), so this file says so for the hub's addresses only.
+// Sign-in travels as a bearer token, never a cookie, so a hub page can only act for a player who signed in
+// on that page. Staff routes and the Stripe webhook stay closed to it.
+export const HUB_ORIGINS = [
+  "https://paw-sitive-playhouse-rush.lovable.app",
+  "https://id-preview--acd6158e-ca42-414d-a979-e8b24d27b4b1.lovable.app",
+  "https://play.pawtasticacademy.com",
+];
+const GAME_API = "/api/public/game/";
+const STAFF_API = "/api/public/game/staff";
+
+/** The hub address a browser request came from, or null (no Origin, this site itself, or anything else). */
+export function hubOrigin(request: Request): string | null {
+  const origin = request.headers.get("origin");
+  if (!origin || !HUB_ORIGINS.includes(origin)) return null;
+  if (origin === new URL(request.url).origin) return null;
+  return origin;
+}
+
+function gameApi(request: Request) {
+  const path = new URL(request.url).pathname;
+  if (!path.startsWith(GAME_API)) return false;
+  return !(path === STAFF_API || path.startsWith(`${STAFF_API}/`));
+}
+
+function corsHeaders(origin: string): Record<string, string> {
+  return {
+    "Access-Control-Allow-Origin": origin,
+    "Access-Control-Allow-Methods": "GET, POST, PUT, OPTIONS",
+    "Access-Control-Allow-Headers": "accept, authorization, content-type",
+    "Access-Control-Max-Age": "600",
+    Vary: "Origin",
+  };
+}
+
+/** The browser's permission check (OPTIONS) from the hub, answered here; null for every other request. */
+export function preflight(request: Request): Response | null {
+  if (request.method !== "OPTIONS" || !gameApi(request)) return null;
+  const origin = hubOrigin(request);
+  return origin ? new Response(null, { status: 204, headers: corsHeaders(origin) }) : null;
+}
+
+/** Lets the hub read this server's game API answers. Every other response is returned untouched. */
+export function withCors(request: Request, response: Response): Response {
+  const origin = gameApi(request) ? hubOrigin(request) : null;
+  if (!origin) return response;
+  const headers = new Headers(response.headers);
+  for (const [key, value] of Object.entries(corsHeaders(origin))) headers.set(key, value);
+  return new Response(response.body, {
+    status: response.status,
+    statusText: response.statusText,
+    headers,
+  });
+}
+
+/**
+ * Where Stripe sends the buyer back: the hub's Graduation Day page when they bought inside the hub, otherwise
+ * this site's game. `approved` is approvedOrigin(request), this site's own checked address.
+ */
+export function returnBase(request: Request, approved: string | undefined): string {
+  const hub = hubOrigin(request);
+  return hub ? `${hub}/graduation` : `${approved}/play/index.html`;
+}
